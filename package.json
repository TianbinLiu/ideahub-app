{
  "name": "ideahub-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "protect": "node scripts/protect-asset.mjs",
    "build:app": "tsc && vite build && node scripts/prune-app-assets.mjs && npx cap sync android",
    "apk": "npm run build:app && cd android && gradlew assembleDebug",
    "apk:release": "npm run build:app && cd android && gradlew assembleRelease",
    "aab": "npm run build:app && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/fiber": "^9.3.0",
    "ammojs-typed": "^1.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "three": "^0.180.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
