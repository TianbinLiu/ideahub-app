<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false：登录 token 存在 WebView 的 localStorage，
         开备份等于允许 adb backup / 云备份把登录态整个搬走 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ★ 冷启动就锁竖屏，不能只靠 JS。人横着手机点图标时，Activity 会先按
             系统方向起来，等 WebView 载完 JS 再转回竖屏 —— 用户看到的是"开屏歪了一下"。
             这里定基线，工坊页进去时再由 useOrientationLock 运行时解锁（运行时的
             setRequestedOrientation 覆盖 manifest，退出工坊会重新锁回来）。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 第三方登录的回程。Google 明确拒绝在应用内 WebView 里跑授权页
                 （disallowed_useragent），所以授权必须交给系统浏览器，登完由服务端
                 302 到 ideahub://oauth?token=… 把人送回来，@capacitor/app 的
                 appUrlOpen 事件接住（见 src/utils/oauth.ts）。
                 ★ scheme 改名要三处同步：这里、utils/oauth.ts 的 APP_SCHEME、
                   服务端 oauth.routes.js 的回跳白名单。
                 ★ 上面的 launchMode="singleTask" 是这条链路能成立的前提：
                   否则回程会再开一个 Activity 实例，回到的是一个全新的空 WebView。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ideahub" android:host="oauth" />
            </intent-filter>

        </activity>

        <!-- QQ 登录（open_sdk 3.5.19，jar 在 android/app/libs/）。这两个 Activity 是 SDK 自带的，
             必须在这里声明 —— 漏了的表现是**点了 QQ 登录什么都不发生**，logcat 里只有一条
             ActivityNotFoundException，UI 上没有任何反馈，很容易误判成"插件没注册"。

             ★ scheme 里的 ${qqAppId} 由 build.gradle 注入，别在这里手写死数字（同源的理由见那边）。
             ★ noHistory=true 是 SDK 要求的：授权页不能留在返回栈里，否则用户按返回键会
               重新触发一次授权回跳。 -->
        <activity
            android:name="com.tencent.tauth.AuthActivity"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tencent${qqAppId}" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.tencent.connect.common.AssistActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="behind"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 微信回执的固定落点（<包名>.wxapi.WXEntryActivity，位置是 SDK 死规矩——
             放错没有任何报错，只是授权完永远回不来）。exported 必须 true：是微信在拉起它。
             taskAffinity 钉在本应用：别让透明壳落进微信的任务栈。 -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.ideahub.branchvideo"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 跟读录音（真人卡录本人音色样本，components/VoiceRecorder）。
         Capacitor 的 WebChromeClient 收到页面 getUserMedia 的 PermissionRequest 时，
         只有清单里声明了这条才会去弹系统授权——不声明就是**静默拒**，页面只看到
         NotAllowedError，一句系统弹窗都没有。⚠ 老包（versionCode ≤40）没有这条：
         老包上跟读永远拿不到麦克风，VoiceRecorder 的报错文案专门写了这一情况 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+ 的包可见性。不声明这条，QQ SDK 查不到本机装没装 QQ，
         isSupportSSOLogin 恒为 false —— 装了 QQ 的用户也会被塞进 H5 授权页，
         得重新输账号密码。功能"能用"，但体验退了一档，而且没有任何报错。 -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <!-- 微信同理：不声明的话 isWXAppInstalled 恒 false，装了微信也说没装 -->
        <package android:name="com.tencent.mm" />
    </queries>
</manifest>
